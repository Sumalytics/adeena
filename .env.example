# Administration connection for migrations. Do not run the application with this role.
DATABASE_URL=postgresql://daaflow_local:replace-me@127.0.0.1:5432/adeen_dev
# Least-privileged application role. Replace the password locally. Do not commit a real password.
ADEENA_APP_DATABASE_URL=postgresql://adeena_app:replace-me@127.0.0.1:5432/adeen_dev
# Dedicated worker login. Provision this PostgreSQL role separately; never reuse the app credential.
ADEENA_VISUAL_WORKER_DATABASE_URL=postgresql://adeena_visual_worker:replace-me@127.0.0.1:5432/adeen_dev
# Supabase Auth. Publishable values may be public. Do not add a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
# Optional private directory for original bytes. Defaults to data/private-sources. Do not point this at public/.
# ADEENA_PRIVATE_STORAGE=
# Editing provider. deterministic-fixture is local and unbilled. configured-provider can call a model only when every line below is set.
# ADEENA_EXPERIENCE_PROVIDER=deterministic-fixture
# ADEENA_AI_API_KEY=
# ADEENA_AI_MODEL=
# ADEENA_AI_API_URL=
# ADEENA_AI_PRICE_VERSION=
# ADEENA_AI_SPEND_CAP_USD=
# ADEENA_AI_MAX_EDIT_COST_USD=
# ADEENA_AI_SPEND_AUTHORIZED=development
# A paid edit also needs the matching non-zero entry in PRICE_SCHEDULES.
# The verified GPT-5.4 Mini standard schedule key is openai-gpt-5.4-mini-standard-2026-10.
# free-development calls Groq only. It is rejected when NODE_ENV=production.
# Set ADEENA_GROQ_PLAN=free only after confirming that the Groq organization is on the Free plan.
# A zero price is not proof that a request is free. Leave ADEENA_AI_SPEND_AUTHORIZED unset in this mode.
# Keep the Groq key in ADEENA_GROQ_API_KEY. A duplicate ADEENA_AI_API_KEY keeps the first value.
# Groq's published rate-limit table is the Developer plan, not the Free plan.
# This application caps development calls at 5 per process session and 10 per UTC day.
# Groq processes the prompt to answer the request. The Responses API is in beta.
# The Responses guide checked on 2026-10-21 does not publish a retention period, so none is recorded here.
# Send only an original, non-sensitive, founder-authorized development fixture.
# ADEENA_AI_EXECUTION_MODE=free-development
# ADEENA_RUNTIME=local-development
# Synthetic /studio stays closed unless ADEENA_RUNTIME is local-development or nonproduction-test.
# NODE_ENV=production closes it even when that runtime value is present.
# ADEENA_GROQ_PLAN=free
# ADEENA_GROQ_API_KEY=
# ADEENA_AI_MODEL=openai/gpt-oss-120b
# ADEENA_AI_API_URL=https://api.groq.com/openai/v1/responses
# ADEENA_FREE_SESSION_LIMIT=5
# ADEENA_FREE_DAY_LIMIT=10
